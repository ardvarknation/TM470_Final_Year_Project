# ------ The code below is used for implementing the 1D-Convolutional Neural Networks (1D-CNN) models used in experiments --------

# Imports for CNN Models.
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report
from tensorflow.keras.models import Sequential, Model
from tensorflow.keras.layers import Conv1D, MaxPooling1D, Flatten, Dense, Dropout, Input
from tensorflow.keras.utils import to_categorical
import time

# Read in data from CSV file.
print("Loading data...")
dataset = pd.read_csv("/content/.../labelled_bsl_data.csv")
print("Data loaded.")

# Separate the features and labels pairings in CSV data file.
X = dataset.iloc[:, :-1].values     # Select all rows and all columns except the last one (:-1) and assign to features (X).
y = dataset.iloc[:, -1].values      # Select all rows and only the last column (-1) and assign as class labels (y).

# Encode labels by converting categorical labels to numerical format for Machine Learning.
label_encoder = LabelEncoder()      # Create instance of LabelEncoder.
y_encoded = label_encoder.fit_transform(y)  # Learns the unique labels from the original dataset and transforms into integer representation.
y_categorical = to_categorical(y_encoded)    # One-hot encoding convers integer-encoded labels into binary matrix representation.

# Normalise features prior to training for consistent results.
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Reshape for Conv1D: (samples, 42 landmarks, 3 coords).
X_reshaped = X_scaled.reshape(-1, 42, 3)

# Produce train/test splits.
X_train, X_test, y_train, y_test = train_test_split(X_reshaped, y_categorical, test_size=0.3, random_state=42)

# Build Conv1D model according to each model's specification.
# Use Input(shape) as the first layer.
input_shape = (X_train.shape[1], X_train.shape[2])
inputs = Input(shape=input_shape)

x = Conv1D(64, kernel_size=3, activation='relu')(inputs)
x = MaxPooling1D(pool_size=2)(x)
x = Dropout(0.3)(x)

x = Conv1D(128, kernel_size=3, activation='relu')(x)
x = MaxPooling1D(pool_size=2)(x)
x = Dropout(0.3)(x)

x = Flatten()(x)
x = Dense(128, activation='relu')(x)
x = Dropout(0.3)(x)

outputs = Dense(y_categorical.shape[1], activation='softmax')(x)

# Change model number below to match CNN model used.
cnn_model_1 = Model(inputs=inputs, outputs=outputs)

# Display summary for CNN model.
cnn_model_1.summary()    # Change model number according to model used.

# Compile model using Adam optimizer with a default rate. Change model number accordingly.
cnn_model_1.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['categorical_accuracy'])

# Train model.
print("Training model...")

