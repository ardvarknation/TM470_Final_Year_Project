# Evaluate CNN models on test data.
print("\nTesting model...")
pred_prob = cnn_model_1.predict(X_test)  # change model number accordingly.
pred_values_encoded = np.argmax(pred_prob, axis=1)
pred_values_cnn_1 = label_encoder.inverse_transform(pred_values_encoded)  # change to pred_values_cnn_2, 3, 4...

# Decode true labels.
