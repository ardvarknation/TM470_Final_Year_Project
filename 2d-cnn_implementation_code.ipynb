# -------- Use for implementation of custom 2D-CNN models used during experiments --------

# Imports for Custom CNN models.
import pandas as pd
import numpy as np
from sklearn.preprocessing import LabelEncoder, StandardScaler
from tensorflow.keras.utils import to_categorical
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Conv2D, MaxPooing2D, Flatten, Dense, Dropout, Input
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report
import time

# Load data from CSV file.
df = pd.read_csv("/content/.../labelled_bsl_data.csv")

# Separate the features and labels pairings in CSV file.
X = df.iloc[:, :-1].values    # Select all rows and all columns except the last one (:-1) and assign to features (X).
y = df.iloc[:, -1].values     # Select all rows and last column only (-1) and assign as class labels (y).

# Encode labels by converting categorical labels to numerical format for machine learning.
label_encoder = LabelEncoder()    # Create instance of LabelEncoder.
y_encoded = label_encoder.fit_transform(y)  # Learns the unique labels from the original labels and transforms into larger representation.
y_categorical = to_categorical(y_encoded)  # One-hot encoding converts integer-encoded labels into binary matrix representation.

# Normalize features prior to training for consistent results.
scaler = StandardScaler()    
X_scaled = scaler.fit_transform(X)

# Reshape for 2D-CNN input: (samples, height, width, channels)
# For 126 features, reshape to (42, 3, 1).
X_reshaped = X_scaled.reshape(-1, 42, 3, 1)

# Build custom CNN models by using appropriate model specifications and modify layers as required.
custom_cnn_model_1 = Sequential([
  Input(shape=(42, 3, 1)),
  Conv2D(32, (2, 2), activation='relu', padding='same'),
  MaxPooling2D((2, 1)),
  Conv2D(64, (2, 2), activation='relu', padding='same'),
  MaxPooling2D((2, 1)),
  Flatten(),
  Dense(128, activation='relu'),
  Dropout(0.3),
  Dense(y_categorical.shape[1], activation='softmax')
])

# Change model number below for summary for given model.
custom_cnn_model_1.summary()

# Compile each model by changing the model number as required.
custom_cnn_model_1.compile(optimizer='adam', loss='categorical_crossentropy'. metrics=['categorical_accuracy'])

# Produce train/test splits.
X_train, X_test, y_train, y_test = train_test_split(X_reshaped, y_categorical, test_size=0.3, stratify=y_encoded)

# Train model.
print("Model training...")

# Start timer for use as complexity measure.
start = time.time()

# Train custom CNN models by modifying model number and epochs below.
history_custom_cnn_model_1 = custom_cnn_model_1.fit(X_train, y_train, epochs=30, batch_size=32, validation_split=0.5)

# Stop timer.
end = time.time()
print(f"Model trained in: {end - start:.2f} seconds.")
