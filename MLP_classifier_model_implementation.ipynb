# Additional imports for MLP models.
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Dropout
from tensorflow.keras.utils import to_categorical
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report
import time

# Read in data from CSV data file.
print("Loading data...")
dataset = pd.read_csv("/content/.../labelled_bsl_data.csv")
print("Data loaded.")

# Separate the features and labels pairings in CSV data file.
X = dataset.iloc[:, :-1]  # Select all rows and all columns except the last one (:-1) and assign to features (X).
y = dataset.iloc[:, -1]  # Select all rows and only the last column (-1) and assign as class label to (y).

# Encode labels by converting the categorical labels to numerical format for Machine Learning.
label_encoder = LabelEncoder()  # Create an instance of LabelEncoder.
y_encoded = label_encoder.fit_transform(y)  # Learns unique labels from original labels and transforms into larger representation.
y_categorical = to_categorical(y_encoded)  # One-hot encoding converts integer-encoded labels into binary matrix representation.

# Produce training and testing splits.
print("Splitting into training and testing datasets...")
X_train, X_test, y_train_encoded, y_test_encoded = train_test_split(X, y_encoded, test_size=0.3, random_state=42)
print("Splitting complete.")

# Normalise/Standardise the features prior to training for consistent results.
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# One-hot encode the split labels to ensure training and testing labels also encoded separately.
y_train_categorical = to_categorical(y_train_encoded)
y_test_categorical = to_categorical(y_test_encoded)

# Build MLP Model - change to mlp_model_2, mlp_model_3, ...4, ...5, etc. as required.
# Different model structures can be added below from corresponding model writeups.
mlp_model_1 = Sequential([
  Dense(512, activation='gelu', input_shape=(X_train_scaled.shape[1],)),
  Dropout(0.3),
  Dense(256, activation='gelu'),
  Dropout(0.3),
  Dense(128, activation='gelu'),
  Dropout(0.3),
  Dense(33, activation='softmax'),  # for 33 classes.
])

# Display summary for MLP Model - modify to appropriate model number as required.
mlp_model_1.summary()

# Compile the MLP model - modify to appropriate model number as required.
mlp_model_1.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['categorical_accuracy'])

# Start training timer to use in complexity measure.
start = time.time()

# Train MLP Model 1 or alternative MLP Models by modifying model number accordingly.
history_mlp_model_1 = mlp_model_1.fit(X_train_scaled, y_train_categorical, epochs=30, verbose=0, batch_size=32, validation_split=0.2)

# Stop timer.
end = time.time()

print("Model trained in: " + str(end - start) + " seconds.")

print("\nTesting model...")

# Generate predictions from test data by modifying model number as required.
pred_prob = mlp_model_1.predict(X_test_scaled)  # Change to mlp_model_2, 3, 4, ...
pred_values_encoded = np.argmax(pred_prob, axis=1)
pred_values_mlp_1 = label_encoder.inverse_transform(pred_values_encoded)  # Change assignment variable to 2, 3, 4, 5...

# Store evaluation metrics using original y_test for comparison.
acc = accuracy_score(label_encoder.inverse_transform(y_test_encoded), pred_values_mlp_1)  # Change to mlp_2, 3, 4, ...
prec = precision_score(label_encoder.inverse_transform(y_test_encoded), pred_values_mlp_1, average='weighted')  # Change to mlp_2, 3, 4, ...
rec = recall_score(label_encoder.inverse_transform(y_test_encoded), pred_values_mlp_1, average='weighted')  # Change to mlp_2, 3, 4, ...
