# ---- Code used in implementation of SVM Model 4 using scikit-learn data pipeline ----

# Additional imports and setup of scikit-learn data pipeline.
import numpy as np
from sklearn.pipeline import make_pipeline, Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report
import time

X = np.array([[-1, -1], [-2, -1], [1, 1], [2, 1]])  # define NumPy array (X) representing features of data, each inner list is data point with two features.
y = np.array([1, 1, 2, 2])  # define NumPy array (y) representing labels corresponding to data points.

# Create machine learning pipeline.
clf = make_pipeline(StandardScaler(), SVC(gamma='auto'))  # standardise features by removing the mean and scaling to unit variance.
clf.fit(X, y)  # Train the pipeline.
Pipeline(steps=[('standardscaler', StandardScaler()),
                ('svc', SVC(gamma='auto'))])  # confirm that pipeline object successfully created and fitted to data.

# Read in data from CSV file.
print("Loading data...")
dataset = pd.read_csv("/content/.../labelled_bsl_data.csv")
print("Data loaded.")

# Separate the features and labels pairings in CSV data file.
X = dataset.iloc[:, :-1]   # Select all rows except the last one (:-1) and assign to features (X).
y = dataset.iloc[:, -1]    # Select all rows and only the last column (-1) and assign as class label to (y).

# Produce training and testing splits.
print("Splitting data into training and testing datasets...")
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)
print("Splitting complete.")

# Standardise the features prior to training for consistent results.
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.fit_transform(X_test)

# Train SVM model using data pipeline.
print("\nTraining model...")
svm_model_4 = Pipeline([('scaler', StandardScaler()), ('svm', SVC(kernel='linear', gamma='auto', C=1.0, random_state=42))])
print(svm_model_4)

# Start timer for model training used to calculate model complexity.
start = time.time()

# Fit model to training data.
svm_model_4.fit(X_train, y_train)

# Stop timer.
end = time.time()

print("\nModel trained in: " + str(end - start) + " seconds.")

print("\nTesting model...")

# Generate predictions from test data for SVM model 4.
pred_values_svm_4 = svm_model_4.predict(X_test)

# Store metrics captured from test data and predicted values.
acc = accuracy_score(y_test, pred_values_svm_4)
prec = precision_score(y_test, pred_values_svm_4, average='weighted')
rec = recall_score(y_test, pred_values_svm_4, average='weighted')
f1 = f1_score(y_test, pred_values_svm_4, average='weighted')
report = classification_report(y_test, pred_values_svm_4)

# Display report for SVM Classifier Model 4.
print("\nValidation metrics:")
print("Accuracy: " + str(acc * 100) + "%")
print("Precision: " + str(prec))
print("Recall: " + str(rec))
print("F1 Score: " + str(f1))
print("\nClassification Report:")
print(report)

