# ---- Use to implement the Support Vector Machine (SVM) Classifier Models 1, 2 and 3 used in experiments ----

# Additional imports required for SVM Classifier (SVC) models.
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report
import time

# Read in data from CSV file.
print("Loading data...")
dataset = pd.read_csv("/content/.../labelled_bsl_data.csv")
print("Data loaded.")

# Separate the features and labels pairings in CSV data file.
X = dataset.iloc[:, :-1]  # Select all rows and columns except last (:-1) and assign features to (X).
y = dataset.iloc[:, -1]  # Select all rows and last column (-1) only and assign as class label to (y).

# Produce training and testing splits.
print("Splitting into training and testing datasets...")
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)
print("Splitting complete.")

# Standardise the features prior to training for consistent results.
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

print("\nTraining model...")
# Comment out line below when uncommenting lines further below to initialise svm_model_2 or svm_model_3.
svm_model_1 = SVC(kernel='linear', C=1.0, random_state=42)  # linear kernel.

# Uncomment line below to initialise svm_model_2.
# svm_model_2 = SVC(kernel='poly', C=1.0, random_state=42)  # poly kernel.

# Uncomment line below to initialise svm_model_3.
# svm_model_3 = SVC(kernel='rbf', gamma='auto', C=1.0, random_state=42)  # rbf kernel and gamma scaling.

print(svm_model_1)  # Change to svm_model_2 or svm_model_3 as appropriate.

# Start timer for model training for use as part of complexity measure.
start = time.time()

# Fit the svm model on the training data.
svm_model_1.fit(X_train_scaled, y_train)    # change to svm_model_2 or svm_model_3.fit.

# End training timer.
end = time.time()

print("Model trained in: " + str(end - start) + " seconds.")

print("\nTesting model...")

# Generate predictions for each SVM classifier by commenting out line below and uncommenting according to model used.
pred_values_svm_1 = svm_model_1.predict(X_test_scaled)

# Uncomment line below for predicted values for svm_model_2.
# pred_values_svm_2 = svm_model_2.predict(X_test_scaled)

# Uncomment line below for predicted values for svm_model_3.
# pred_values_svm_3 = svm_model_3.predict(X_test_scaled)

# Store metrics captured from test data and predicted values.
acc = accuracy_score(y_test, pred_values_svm_1)  # Change to pred_values_svm_2 or pred_values_svm_3.
prec = precision_score(y_test, pred_values_svm_1, average='weighted') # Change to pred_values_svm_2 or pred_values_svm_3.
rec = recall_score(y_test, pred_values_svm_1, average='weighted')  # Change to pred_values_svm_2 or pred_values_svm_3.
f1 = f1_score(y_test, pred_values_svm_1, average='weighted')    # Change to pred_values_svm_2 or pred_values_svm_3.
report = classification_report(y_test, pred_values_svm_1)  # Change to pred_values_svm_2 or pred_values_svm_3.

# Display report for SVM Classifier model.
print("\nValidation metrics:")
print("Accuracy: " + str(acc*100) + "%")
print("Precision: " + str(prec))
print("Recall: " + str(rec))
print("F1 Score: " + str(f1))
print("\nClassification Report:")
print(report)
