# ---- Use the code below to calculate the True Positive, False Positive, True Negative and False Negative for each SVM ------

# 'cm' is the confusion matrix calculated using sklearn.metrics.confusion_matrix.
# 'labels' is the list of class labels used for the confusion matrix.

# Get the TP, FP, TN, and FN for a specific class (as multi-class classification) by iterating through confusion matrix.

# Example: for the first class use (labels[0]).
class_index = 30  # Change this index to get metrics for a different class (0-32).
class_label = labels[class_index]

# True Positives (TP): The number of instances of the positive class correctly predicted as positive.
TP = cm[class_index, class_index]

# False Positives (FP): The number of instances of the negative classes incorrectly predicted as positive.
FP = cm[:, class_index].sum() - TP

# False Negatives (FN): The number of instances of the positive class incorrectly predicted as negative.
FN = cm[class_index, :].sum() - TP

# True Negatives (TN): The number of instances of the negative class correctly predicted as negative.
TN = cm.sum() - TP - FP - FN

# Display TP, FP, FN and TN for a class.
print(f"Metrics for class '{class_label}':")
print(f"True Positives (TP): {TP}")
print(f"False Positives (FP): {FP}")
print(f"True Negatives (TN): {TN}")

# Loop through all classes to get these metrics for each one.
print("\nMetrics for all classes:")
for i, label in enumerate(labels):
  TP = cm[i, i]
  FP = cm[:, i].sum() - TP
  FN = cm[i, :].sum() - TP
  TN = cm.sum() - TP - FP - FN
  print(f"Class '{label}': TP={TP}, FP={FP}, FN={FN}, TN={TN}")
  
