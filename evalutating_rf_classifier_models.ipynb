# ---- Calculate and display the True Positives (TP), False Positives (FP), True Negatives (TN) and False Negatives (FN) for each class ----

# 'cm' is the confusion matrix calculated using sklearn.metrics.confusion_matrix.
# 'labels' is the list of class labels used for the confusion matrix.

# Get TP, FP, TN, and FN fo specific class (as multi-class classification) by iterating through the confusion matrix.

# Example for the first class (labels[0]) of 33 classes.
class_index = 0  # Change this index to get metrics for a different class (0-32).
class_label = labels[class_index]

# True Positives (TP): The number of instances of the positive class correctly predicted as positive.
TP = cm[class_index, class_index]

# False Positives (FP): The number of instances of the negative classes incorrectly predicted as positive.
FP = cm[:, class_index].sum() - TP

# False Negatives (FN): The number of instances of the negative classes incorrectly predicted as negative.
FN = cm[class_index, :].sum() - TP

# True Negatives (TN): The number of instances of the negative classes correctly predicted as negative.
TN = cm.sum() - TP - FP - FN

# Display TP, FP, FN, TN for class.
print(f"Metrics for class '{class_label}':")
print(f"True Positives (TP): {TP}")
print(f"False Positives (FP): {FP}")
print(f"False Negatives (FN): {FN}")
print(f"True Negatives (TN): {TN}")

# Loop through all classes to get and display metrics for each one.
print("\nMetrics for all classes:")
for i, label in enumerate(labels):
  TP = cm[i, i]
  FP = cm[:, i].sum() - TP
  FN = cm[i, :].sum() - TP
  TN = cm.sum() - TP - FP - FN
  print(f"Class '{label}': TP={TP}, FP={FP}, FN={FN}, TN={TN}")
  
 
