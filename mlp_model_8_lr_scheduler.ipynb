# -------- Use for implementing MLP Model 8 which utilised a learning rate scheduler callback --------

# Additional import for LearningRateScheduler and tensorflow.
import tensorflow as tf
from tensorflow.keras.callbacks import LearningRateScheduler

# Define a learning rate scheduler function.
def scheduler(epoch, lr):
  if epoch < 20:
    return lr  # starts at 1e-3.
  else:
    return 1e-4

# Create LearningRateScheduler callback.
lr_scheduler = LearningRateScheduler(scheduler)

# Build MLP Model 8.
mlp_model_8 = Sequential([
  Dense(512, activation='relu', input_shape(X_train_scaled.shape[1],)),
  Dropout(0.2),
  Dense(256, activation='relu'),
  Dropout(0.2),
  Dense(128, activation='relu'),
  Dropout(0.2), 
  Dense(64, activation='relu'),
  Dropout(0.2),
  Dense(32, activation='relu'),
  Dropout(0.2),
  Dense(33, activation='softmax')  # for 33 classes.
])

# Display summary for mlp_model_8.
mlp_model_8.summary()

# Compile mlp_model_8 with initial learning rate specified for optimizer.
mlp_model_8.compile(optimizer=keras.optimizers.Adam(learning_rate=1e-3), loss='categorical_crossentropy', metrics=['categorical_accuracy'])

# Start timer for use as measure of complexity.
start = time.time()

# Train mlp_model_8 for 70 epochs, with lr_scheduler.
history_mlp_model_8 = mlp_model_8.fit(X_train_scaled, y_train_categorical, epochs=70, callbacks=[lr_scheduler], verbose=0, batch_size=32, validation_split=0.2)

