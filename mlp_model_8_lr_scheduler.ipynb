end = time.time()


# -------- Code for additional learning rate scheduler function produced ----------

# Define learning rate scheduler function.
def scheduler(epoch, lr):
  if epoch < 20:
    return lr
  else:
    return lr * tf.math.exp(-0.1)

# Create lr scheduler callback.
lr_scheduler = LearningRateScheduler(scheduler)


# ---------- Code for early stopping function for callback above -----------

# Additional import for early stopping.
from tensorflow.keras.callbacks import EarlyStopping

