# ------- Use code below to plot the Training and Validation Accuracy and Loss for CNN Models --------

# Additional import for matplotlib library for visualisations.
import matplotlib.pyplot as plt 

# Plot training/validation accuracy for each 1D-CNN by modifying model numbers below accordingly.
plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.plot(history_cnn_1.history['categorical_accuracy'], label='Training Accuracy')  # change to cnn_2.history, cnn_3, cnn_4, ...
plt.plot(history_cnn_1.history['val_categorical_accuracy'], label='Validation Accuracy')  # change cnn_2, cnn_3, ...
plt.title('Model Accuracy (1D-CNN) CNN 1')  # change model number accordingly.
